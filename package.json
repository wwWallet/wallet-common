{
	"name": "wallet-common",
	"version": "2.0.0",
	"main": "dist/index.js",
	"license": "BSD-2-Clause",
	"repository": {
		"type": "git",
		"url": "https://github.com/wwWallet/wallet-common.git"
	},
	"files": [
		"dist/**/*",
		"src/**/*",
		"package.json"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"test": "tsc && vitest run",
		"test-start": "vitest",
		"build": "rm -rf dist/ && tsc",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings=0",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"prepare": "npm run build"
	},
	"dependencies": {
		"@noble/curves": "^2.2.0",
		"@owf/mdoc": "^0.6.0",
		"@peculiar/x509": "^2.0.0",
		"@sd-jwt/core": "^0.10.0",
		"asn1js": "^3.0.5",
		"axios": "^1.18.0",
		"buffer": "^6.0.3",
		"dcql": "^3.0.1",
		"jose": "^5.9.6",
		"pkijs": "^3.2.4",
		"reflect-metadata": "^0.2.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@sd-jwt/types": "^0.10.0",
		"@types/node": "^24.10.2",
		"@xmldom/xmldom": "^0.9.12",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.0.0",
		"prettier": "^3.8.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.53.0",
		"vitest": "^4.1.11"
	}
